# Database. The default is a local SQLite file (no setup needed).
# To use PostgreSQL instead (e.g. after `docker compose up -d`), use:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/notesdb
DATABASE_URL=sqlite:///./data/notes.db

# Where downloaded files and git mirrors are stored
DATA_DIR=./data

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Polite crawling
REQUEST_DELAY_SECONDS=1.0
RESPECT_ROBOTS_TXT=true

# ---- Optional AI flashcard generation (not required) ----
# AI_PROVIDER = none | anthropic | openai   ("openai" also works with any OpenAI-compatible server, e.g. Ollama)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
